<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plain URDF for the KUKA KR120 R2700-2, hand-written to replace
  kr120_r2700_2.urdf.xacro.

  The .xacro cannot be expanded here: it only wraps
  $(find kuka_quantec_support)/urdf/kr120_r2700_2_macro.xacro, and that ROS
  package is not present in this repo. The links/joints below reproduce the
  KR120 R2700-2 kinematics so the supplied .dae meshes can be visualized.

  The meshes are authored in the robot's zero-configuration world frame (the
  KUKA support-package convention), so every <visual> origin is identity and
  all offsets live on the joint origins.

  OPW kinematic parameters (KUKA KR120 R2700-2 datasheet, verified against
  the upstream kroshu kuka_quantec_support kr120_r2700_2_macro.xacro):

    a1 =  0.330   # A1 axis -> A2 axis, horizontal offset
    a2 = -0.115   # elbow offset, A3 axis -> forearm/A4 axis
    b  =  0.000   # no lateral offset
    c1 =  0.645   # floor -> A2 axis height
    c2 =  1.150   # A2 -> A3 (upper arm)
    c3 =  1.220   # A3 -> A5 wrist center (forearm)
    c4 =  0.215   # A5 wrist center -> flange
    joint_offsets         = [0, -pi/2, 0, 0, 0, 0]
    joint_sign_corrections = [-1, 1, 1, -1, 1, -1]

  Note this URDF's zero pose has the upper arm vertical (KUKA A2=-90,
  A3=+90), so A2/A3 limits are shifted by +90/-90 deg vs KUKA controller
  values (A2: -140..-5 deg -> -50..+85 deg; A3: -120..+168 deg -> -210..+78 deg).
-->
<robot name="kr120_r2700_2">
  <!-- Colors -->
  <material name="kuka_orange">
    <color rgba="0.94 0.42 0.07 1.0"/>
  </material>
  <material name="kuka_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- World -->
  <link name="world"/>

  <joint name="world-base_link" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/base_link.dae"/>
      </geometry>
      <material name="kuka_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/base_link.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.1 0 0.18" rpy="0 0 0"/>
      <mass value="300.0"/>
      <inertia ixx="12.0" ixy="0.0" ixz="0.0" iyy="12.0" iyz="0.0" izz="15.0"/>
    </inertial>
  </link>

  <!-- A1: base rotation about Z -->
  <joint name="joint_a1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.645" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.2289" upper="3.2289" effort="0" velocity="1.9722"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 -0.645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_1.dae"/>
      </geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_1.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="200.0"/>
      <inertia ixx="8.0" ixy="0.0" ixz="0.0" iyy="8.0" iyz="0.0" izz="8.0"/>
    </inertial>
  </link>

  <!-- A2: shoulder -->
  <joint name="joint_a2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.330 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8727" upper="1.4835" effort="0" velocity="1.9452"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="-0.330 0 -0.645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_2.dae"/>
      </geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="-0.330 0 -0.645" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_2.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="150.0"/>
      <inertia ixx="10.0" ixy="0.0" ixz="0.0" iyy="10.0" iyz="0.0" izz="5.0"/>
    </inertial>
  </link>

  <!-- A3: elbow -->
  <joint name="joint_a3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 1.150" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.6652" upper="1.3614" effort="0" velocity="2.0833"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="-0.330 0 -1.795" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_3.dae"/>
      </geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="-0.330 0 -1.795" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_3.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.3 0 0.1" rpy="0 0 0"/>
      <mass value="100.0"/>
      <inertia ixx="4.0" ixy="0.0" ixz="0.0" iyy="6.0" iyz="0.0" izz="6.0"/>
    </inertial>
  </link>

  <!-- A4: wrist roll about X -->
  <joint name="joint_a4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.820 0 0.115" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.1087" upper="6.1087" effort="0" velocity="2.8798"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="-1.150 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_4.dae"/>
      </geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="-1.150 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_4.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.2 0 0" rpy="0 0 0"/>
      <mass value="50.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="2.0" iyz="0.0" izz="2.0"/>
    </inertial>
  </link>

  <!-- A5: wrist bend -->
  <joint name="joint_a5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.400 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1817" upper="2.1817" effort="0" velocity="2.8798"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="-1.550 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_5.dae"/>
      </geometry>
      <material name="kuka_orange"/>
    </visual>
    <collision>
      <origin xyz="-1.550 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_5.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.5" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="0.5"/>
    </inertial>
  </link>

  <!-- A6: flange roll about X -->
  <joint name="joint_a6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0.215 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.1087" upper="6.1087" effort="0" velocity="4.6251"/>
  </joint>

  <link name="link_6">
    <visual>
      <origin xyz="-1.765 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_6.dae"/>
      </geometry>
      <material name="kuka_black"/>
    </visual>
    <collision>
      <origin xyz="-1.765 0 -1.910" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://kuka_quantec_support/meshes/link_6.dae"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Tool flange frame -->
  <joint name="joint_a6-flange" type="fixed">
    <parent link="link_6"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="flange"/>

  <!-- Base frame convention used by KUKA controllers -->
  <joint name="base_link-base" type="fixed">
    <parent link="base_link"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base"/>
</robot>
